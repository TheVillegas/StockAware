# StockAware — variables de entorno
#
# Copiar a .env y ajustar. El archivo .env NO se versiona.
# Estos valores son ficticios y sirven solo para desarrollo local.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=stockaware
POSTGRES_USER=stockaware
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_PORT=5432

# Host visto desde el backend. En Docker Compose es el nombre del servicio;
# fuera de Compose, localhost.
POSTGRES_HOST=localhost

# --- Backend NestJS ---------------------------------------------------------
BACKEND_PORT=3000
NODE_ENV=development

# Firma de los JWT. En produccion debe venir de GitHub Actions Secrets.
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=8h

# Origenes permitidos por CORS, separados por coma. Vacio = todos (solo dev).
CORS_ORIGIN=http://localhost:4200,http://localhost:8100
