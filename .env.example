# Copiar a .env. PG_PASSWORD y JWT_SECRET salen del entorno, no de este archivo.
PG_USER=erp
PG_DATABASE=erp_replica
PG_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=4200
CORS_ORIGIN=http://localhost:4200

# Duracion del token. 3600s es el MAX_IDLE_TIME del ERP original.
JWT_EXPIRA=3600s

NODE_VERSION=22
PYTHON_VERSION=3.13
