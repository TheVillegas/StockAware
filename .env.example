# Copiar a .env y ajustar si hace falta. Con los valores por defecto funciona.
PG_USER=erp
PG_PASSWORD=erp_local
PG_DATABASE=erp_replica
PG_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=4200
CORS_ORIGIN=http://localhost:4200

# Firma de los tokens de sesion. Cambiar en cualquier entorno que no sea local.
JWT_SECRET=replica-erp-local-2026
# Duracion del token. 3600s es el MAX_IDLE_TIME del ERP original.
JWT_EXPIRA=3600s
