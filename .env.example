# StockAware — variables de entorno
#
# Copiar a .env y ajustar. El archivo .env NO se versiona.
# Estos valores son ficticios y sirven solo para desarrollo local.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=stockaware
POSTGRES_USER=stockaware
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_PORT=5432

# Host visto desde el backend. En Docker Compose es el nombre del servicio;
# fuera de Compose, localhost.
POSTGRES_HOST=localhost
