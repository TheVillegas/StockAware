{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "allowJs": true
  },
  "include": ["src/**/*", "eslint.config.js", "jest.config.cjs"],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
